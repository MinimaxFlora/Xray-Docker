# ---------------------------------------------------------------------------
# docker compose reads this file automatically.
# After editing run:  docker compose up -d     (config files are re-rendered)
# ---------------------------------------------------------------------------

# Client facing port (host). Container itself always listens on 443.
PORT=443

# Camouflage site == REALITY target == serverName.
# Requirements: TLS 1.3 + HTTP/2 + the domain in its certificate,
# check with:  docker compose exec xray xray tls ping www.lovelive-anime.jp
#
# www.lovelive-anime.jp verified 2026-10:
#   TLS 1.3 | ALPN h2 | X25519MLKEM768 (post-quantum kex) | cert *.lovelive-anime.jp
#   not on the "likely to get your IP blocked" list (apple/icloud/microsoft/.cn/.ru/.ir)
SNI=www.lovelive-anime.jp

# Public IP or domain of the VPS. Leave empty to auto detect via api.ipify.org.
# If the generated link contains YOUR_SERVER_IP, fill this in and re-run
# `docker compose up -d`.
SERVER_ADDR=

# Node name shown in the client (ASCII only, # is not allowed).
NODE_NAME=XHTTP-Reality-PQ

# 1 = rotate uuid / x25519 / shortId / vlessenc on this start.
# Prefer:  docker compose run --rm xray keygen --force && docker compose up -d
REGEN=0

TZ=Asia/Shanghai

# HTTPS subscription (optional): sudo bash manage.sh cert && sudo bash manage.sh sub
# port used by the nginx "sub" container
SUB_PORT=8443

# host used in the subscription URL; empty = SERVER_ADDR / auto detected IP
CERT_HOST=

# Image pulled by docker compose. Tag follows the bundled Xray core version,
# so upgrading the core == changing the tag here, then:
#   docker compose pull && docker compose up -d
# Alternatives:
#   IMAGE=ghcr.io/minimaxflora/xray-core:v26.10.21
IMAGE=dockorae/xray-core:v26.10.21

# Only used when building locally:
#   docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
# Base image providing the official xray binary.
# ghcr.io is sometimes slow/blocked in mainland China; alternatives:
#   dockerproxy.net mirror:  ghcr.m.daocloud.io/xtls/xray-core:26.10.21
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.10.21
